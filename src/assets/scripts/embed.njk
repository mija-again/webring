---
permalink: 'embed.js'
---
class WebringBanner extends HTMLElement {
    constructor() {
        super();

        this.ringtitle = '{{ meta.title }}';
        this.url = '{{ meta.url }}';
        this.image = this.url + '/assets/images/{{ meta.image }}';
        this.membercount = {{ members | length }};

        this.currentSite = window.location.hostname
            .replace(/^www\./, '')
            .toLowerCase();

        this.shadowObj = this.attachShadow({ mode: 'open' });
        this.render();
    }

    getNavigationUrl(action) {
        return this.url
            + '/navigate/?action='
            + encodeURIComponent(action)
            + '&site='
            + encodeURIComponent(this.currentSite);
    }

    getStyles() {
        return `
        <style>
          * {
            box-sizing: border-box;
          }

          :host {
            display: block;
            width: 100%;
            font-family: Baskerville, "Baskerville Old Face", "Hoefler Text", Garamond, Georgia, serif;
            font-size: 18px;
            text-align: left;
          }

          .webring-banner {
            background-color: #fffdf8;
            color: #2f2a27;
            border: 1px solid #d9d1c5;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(14, 30, 37, 0.12);
            width: 100%;
            max-width: 480px;
            overflow: hidden;
          }

          .webring-banner a {
            color: #6f2f38;
            text-decoration: none;
          }

          .webring-banner a:hover,
          .webring-banner a:focus {
            color: #8f4650;
            text-decoration: underline;
          }

          .webring-banner__header {
            display: flex;
            align-items: center;
            position: relative;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #d9d1c5;
          }

          .webring-banner__description {
            flex: 1;
            min-width: 0;
            padding-right: 2rem;
            color: #2f2a27;
          }

          .webring-banner__kicker {
            margin: 0 0 0.15rem 0;
            line-height: 1.2;
          }

          .webring-banner__image {
            display: block;
            width: 90px;
            height: 90px;
            flex: 0 0 90px;
            margin-right: 1rem;
            border-radius: 50%;
            object-fit: cover;
          }

          .webring-banner__title {
            margin: 0.1rem 0 0.2rem 0;
            font-size: 1.25rem;
            font-weight: bold;
            line-height: 1.1;
            overflow-wrap: break-word;
          }

          .webring-banner__count {
            line-height: 1.25;
          }

          .webring-banner__info {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 0.85rem;
            right: 0.85rem;
            width: 1.35rem;
            height: 1.35rem;
            border: 2px solid #d9d1c5;
            border-radius: 50%;
            font-size: 0.75rem;
            color: #6f2f38;
            background: #fffdf8;
          }

          .webring-banner__links {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: center;
            gap: 0.25rem;
            padding: 0.8rem 1rem;
            margin: 0;
          }

          .webring-banner__link {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            min-width: 0;
            color: #6f2f38;
            white-space: nowrap;
          }

          .webring-banner__link--random {
            justify-self: center;
          }

          .webring-banner__link--next {
            justify-self: end;
          }

          .webring-banner__icon {
            font-size: 1.1em;
            line-height: 1;
          }

          .webring-banner__link--random .webring-banner__icon {
            font-size: 1.4em;
          }

          @media (max-width: 360px) {
            :host {
              font-size: 17px;
            }

            .webring-banner__header {
              padding: 0.7rem 0.8rem;
            }

            .webring-banner__image {
              width: 72px;
              height: 72px;
              flex: 0 0 72px;
              margin-right: 0.75rem;
            }

            .webring-banner__title {
              font-size: 1.05rem;
            }

            .webring-banner__description {
              padding-right: 1.6rem;
            }

            .webring-banner__links {
              padding: 0.7rem 0.8rem;
              gap: 0.15rem;
            }

            .webring-banner__link {
              gap: 0.2rem;
            }
          }
        </style>
        `;
    }

    getTemplate() {
        var memberText = this.membercount === 1
            ? '1 member so far'
            : this.membercount + ' members so far';

        return `
          ${this.getStyles()}

          <div class="webring-banner">
            <div class="webring-banner__header">

              <img
                class="webring-banner__image"
                src="${this.image}"
                alt=""
              />

              <div class="webring-banner__description">
                <div class="webring-banner__kicker">Part of</div>

                <h3 class="webring-banner__title">
                  <a href="${this.url}">
                    ${this.ringtitle}
                  </a>
                </h3>

                <div class="webring-banner__count">
                  ${memberText}
                </div>
              </div>

              <a
                class="webring-banner__info"
                href="${this.url}"
                aria-label="About ${this.ringtitle}"
                title="About ${this.ringtitle}"
              >?</a>
            </div>

            <div class="webring-banner__links">

              <a
                href="${this.getNavigationUrl('prev')}"
                class="webring-banner__link"
                aria-label="Go to previous site in the ring"
              >
                <span class="webring-banner__icon" aria-hidden="true">←</span>
                <span>Previous</span>
              </a>

              <a
                href="${this.getNavigationUrl('random')}"
                class="webring-banner__link webring-banner__link--random"
                aria-label="Go to a random site in the ring"
              >
                <span class="webring-banner__icon" aria-hidden="true">⟳</span>
                <span>Random</span>
              </a>

              <a
                href="${this.getNavigationUrl('next')}"
                class="webring-banner__link webring-banner__link--next"
                aria-label="Go to next site in the ring"
              >
                <span>Next</span>
                <span class="webring-banner__icon" aria-hidden="true">→</span>
              </a>

            </div>
          </div>
        `;
    }

    render() {
        this.shadowObj.innerHTML = this.getTemplate();
    }
}

if (!customElements.get('webring-banner')) {
    customElements.define('webring-banner', WebringBanner);
}
