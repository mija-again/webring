---
permalink: 'embed.js'
---
class WebringBanner extends HTMLElement {
    constructor() {
        super();

        this.ringtitle = '{{ meta.title }}';
        this.url = '{{ meta.url }}';
        this.image = this.url + '/assets/images/{{ meta.image }}';
        this.membercount = {{ members | length }};

        this.currentSite = window.location.hostname
            .replace(/^www\./, '')
            .toLowerCase();

        this.shadowObj = this.attachShadow({ mode: 'open' });
        this.render();
    }

    getNavigationUrl(action) {
        return this.url
            + '/navigate/?action='
            + encodeURIComponent(action)
            + '&site='
            + encodeURIComponent(this.currentSite);
    }

    getStyles() {
        return `
        <style>
          * {
            box-sizing: border-box;
          }

          :host {
            display: block;
            width: 100%;
            font-family: Baskerville, "Baskerville Old Face", "Hoefler Text", Garamond, Georgia, serif;
            font-size: 18px;
            text-align: left;
          }

          .webring-banner {
            background-color: #fffdf8;
            color: #2f2a27;
            border: 1px solid #d9d1c5;
            border-radius: 8px;
            box-shadow: 0 2px 4px rgba(14, 30, 37, 0.12);
            max-width: 480px;
          }

          .webring-banner a {
            color: #6f2f38;
            text-decoration: none;
          }

          .webring-banner a:hover,
          .webring-banner a:focus {
            color: #8f4650;
            text-decoration: underline;
          }

          .webring-banner__header {
            display: flex;
            align-items: center;
            position: relative;
            padding: 0.55rem 1rem;
            border-bottom: 1px solid #d9d1c5;
          }

          .webring-banner__description {
            flex: 1;
            padding-right: 2rem;
            color: #2f2a27;
          }

          .webring-banner__image {
            display: block;
            width: 110px;
            height: 110px;
            flex: 0 0 110px;
            margin-right: 1rem;
            border-radius: 50%;
            object-fit: cover;
          }

          .webring-banner__title {
            margin: 0.1rem 0;
            font-size: 1.45rem;
            font-weight: bold;
            line-height: 1.15;
          }

          .webring-banner__info {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 1rem;
            right: 1rem;
            width: 1.25rem;
            height: 1.25rem;
            border: 2px solid #d9d1c5;
            border-radius: 50%;
            font-size: .75rem;
            color: #6f2f38;
          }

          .webring-banner__links {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 1rem;
            margin: 0;
          }

          .webring-banner__link {
            display: block;
            color: #6f2f38;
          }

          .webring-banner__link--random {
            text-align: center;
          }

          .webring-banner__link--next {
            text-align: right;
          }

          @media (min-width: 400px) {
            .webring-banner__link {
              min-width: 100px;
            }
          }
        </style>
        `;
    }

    getTemplate() {
        var memberWord = this.membercount === 1 ? 'member' : 'members';

        return `
          ${this.getStyles()}

          <div class="webring-banner">
            <div class="webring-banner__header">

              <img
                class="webring-banner__image"
                src="${this.image}"
                alt=""
              />

              <div class="webring-banner__description">
                <div>This site is part of</div>

                <h3 class="webring-banner__title">
                  <a href="${this.url}">
                    ${this.ringtitle}
                  </a>
                </h3>

                <div>
                  A webring with ${this.membercount} ${memberWord}
                </div>
              </div>

              <a
                class="webring-banner__info"
                href="${this.url}"
                aria-label="About ${this.ringtitle}"
                title="About ${this.ringtitle}"
              >?</a>
            </div>

            <div class="webring-banner__links">

              <a
                href="${this.getNavigationUrl('prev')}"
                class="webring-banner__link"
                aria-label="Go to previous site in the ring"
              >⬅️ Previous</a>

              <a
                href="${this.getNavigationUrl('random')}"
                class="webring-banner__link webring-banner__link--random"
                aria-label="Go to a random site in the ring"
              >Random</a>

              <a
                href="${this.getNavigationUrl('next')}"
                class="webring-banner__link webring-banner__link--next"
                aria-label="Go to next site in the ring"
              >Next ➡️</a>

            </div>
          </div>
        `;
    }

    render() {
        this.shadowObj.innerHTML = this.getTemplate();
    }
}

if (!customElements.get('webring-banner')) {
    customElements.define('webring-banner', WebringBanner);
}
